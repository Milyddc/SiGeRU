# Copiar a .env y cambiar los valores. NO subir .env a GitHub.
MYSQL_ROOT_PASSWORD=cambiar_root_password
MYSQL_DATABASE=proyecto
MYSQL_USER=sigeru
MYSQL_PASSWORD=cambiar_password_app
DB_HOST=db
# Misma clave en las tres APIs: así un token emitido por api-usuarios lo aceptan las demás (mínimo 32 caracteres)
JWT_SECRET=cambiar_por_una_cadena_aleatoria_de_al_menos_32_caracteres
CORS_ORIGIN=

# ---- Envío de emails (alertas, avisos de registro y asignaciones) ----
# Dejar MAIL_ENABLED=false para trabajar sin email. Guía paso a paso en docs/EMAIL.md
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# tls = STARTTLS (puerto 587)   |   ssl = SMTPS (puerto 465)
SMTP_SECURE=tls
SMTP_USER=correo-de-la-empresa@gmail.com
SMTP_PASS=clave-de-aplicacion
MAIL_FROM=correo-de-la-empresa@gmail.com
MAIL_FROM_NAME=SiGeRU
# Dirección donde se abre el sistema (se usa en el enlace de los emails)
APP_URL=http://localhost:8080/app
